# ============================================================
#  .gitignore — kaunsi files Git/GitHub par NAHI jaani chahiye
# ============================================================

# ===== Python / Django (backend) =====
venv/
backend/venv/
__pycache__/
*.py[cod]
*$py.class

# Database (local SQLite — isme real data hota hai, push nahi karna)
*.sqlite3
db.sqlite3

# Django generated / runtime
backend/staticfiles/
backend/media/
*.log

# ===== Secrets / Environment variables =====
# (SECRET_KEY, passwords, API keys — ye kabhi public nahi hone chahiye)
.env
*.env
backend/.env

# ===== Node / React (frontend) =====
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.vite/

# ===== Editor / OS junk files =====
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
